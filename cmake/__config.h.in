#pragma once

#define KRYSTALLIC_STAGE                  "@KRYSTALLIC_STAGE@"
#define KRYSTALLIC_STAGE_SHORT            "@KRYSTALLIC_STAGE_SHORT@"

#define KRYSTALLIC_VERSION_X              "@KRYSTALLIC_VERSION_X@"
#define KRYSTALLIC_VERSION_Y              "@KRYSTALLIC_VERSION_Y@"
#define KRYSTALLIC_VERSION_Z              "@KRYSTALLIC_VERSION_Z@"
#define KRYSTALLIC_BUILD_NUMBER           "@KRYSTALLIC_BUILD_NUMBER@"

#define KRYSTALLIC_PRODUCT_VERSION        KRYSTALLIC_VERSION_X "." KRYSTALLIC_VERSION_Y "." KRYSTALLIC_VERSION_Z
#define KRYSTALLIC_VERSION                KRYSTALLIC_PRODUCT_VERSION "." KRYSTALLIC_BUILD_NUMBER

#define KRYSTALLIC_BUILD_TIMESTAMP        "(@KRYSTALLIC_BUILD_TIMESTAMP@)"
#define KRYSTALLIC_BUILD_TIMESTAMP_SHORT  "@KRYSTALLIC_BUILD_TIMESTAMP_SHORT@"
#define KRYSTALLIC_CODENAME               "@KRYSTALLIC_CODENAME@"
#define KRYSTALLIC_PLATFORM               "@KRYSTALLIC_PLATFORM@"
#define KRYSTALLIC_PLATFORM_SHORT         "@KRYSTALLIC_PLATFORM_SHORT@"
#define KRYSTALLIC_COMPILER               "@KRYSTALLIC_COMPILER@"

#if defined(BUILD_CONF_DBG)
#define KRYSTALLIC_BUILD_CONFIG           "Debug"
#define KRYSTALLIC_BUILD_CONFIG_SHORT     "dbg"
#elif defined(BUILD_CONF_CHK)
#define KRYSTALLIC_BUILD_CONFIG           "Checked"
#define KRYSTALLIC_BUILD_CONFIG_SHORT     "chk"
#elif defined(BUILD_CONF_REL)
#define KRYSTALLIC_BUILD_CONFIG           "Release"
#define KRYSTALLIC_BUILD_CONFIG_SHORT     "rel"
#else
#define KRYSTALLIC_BUILD_CONFIG           "Unknown"
#define KRYSTALLIC_BUILD_CONFIG_SHORT     "unk"
#endif

#define KRYSTALLIC_DISPLAY_VERSION        "\"" KRYSTALLIC_CODENAME "\" " KRYSTALLIC_STAGE " " KRYSTALLIC_VERSION " " KRYSTALLIC_BUILD_TIMESTAMP
#define KRYSTALLIC_FULL_DISPLAY_VERSION   KRYSTALLIC_DISPLAY_VERSION " " KRYSTALLIC_PLATFORM " " KRYSTALLIC_BUILD_CONFIG
#define KRYSTALLIC_INNER_BUILD_ID         "\"" KRYSTALLIC_CODENAME "\" " KRYSTALLIC_STAGE_SHORT "_" KRYSTALLIC_VERSION "." KRYSTALLIC_BUILD_TIMESTAMP_SHORT
#define KRYSTALLIC_FULL_BUILD_ID          KRYSTALLIC_INNER_BUILD_ID "." KRYSTALLIC_PLATFORM_SHORT "." KRYSTALLIC_BUILD_CONFIG_SHORT
#define KRYSTALLIC_BUILD_OUTPUT_DIRECTORY KRYSTALLIC_STAGE_SHORT "_" KRYSTALLIC_VERSION "." KRYSTALLIC_BUILD_TIMESTAMP_SHORT

#define KRYSTALLIC_VERSION_MAJ            KRYSTALLIC_VERSION_X
#define KRYSTALLIC_VERSION_MIN            KRYSTALLIC_VERSION_Y
#define KRYSTALLIC_VERSION_REV            KRYSTALLIC_VERSION_Z
#define KRYSTALLIC_STAGE_NAME             KRYSTALLIC_STAGE
#define KRYSTALLIC_STAGE_NAME_SHORT       KRYSTALLIC_STAGE_SHORT
#define KRYSTALLIC_BUILD_STR              KRYSTALLIC_VERSION
#define KRYSTALLIC_BUILD_STR_EXT          KRYSTALLIC_FULL_DISPLAY_VERSION
#define KRYSTALLIC_BUILD_STR_FULL         KRYSTALLIC_FULL_DISPLAY_VERSION " Compiler: " KRYSTALLIC_COMPILER
#define KRYSTALLIC_BUILD_ID               KRYSTALLIC_FULL_BUILD_ID
