#pragma once

#define KRYSTALLIC_STAGE_MAJOR           "@KRYSTALLIC_STAGE_MAJOR@"
#define KRYSTALLIC_STAGE_MINOR           "@KRYSTALLIC_STAGE_MINOR@"
#define KRYSTALLIC_STAGE_NAME            "@KRYSTALLIC_STAGE_NAME@"
#define KRYSTALLIC_STAGE_NAME_SHORT      "@KRYSTALLIC_STAGE_NAME_SHORT@"
#define KRYSTALLIC_VERSION_MAJ           "@KRYSTALLIC_VERSION_MAJ@"
#define KRYSTALLIC_VERSION_MIN           "@KRYSTALLIC_VERSION_MIN@"
#define KRYSTALLIC_VERSION_REV           "@KRYSTALLIC_VERSION_REV@"
#define KRYSTALLIC_BUILD_TIMESTAMP       "(@KRYSTALLIC_BUILD_TIMESTAMP@)"
#define KRYSTALLIC_BUILD_TIMESTAMP_SHORT "@KRYSTALLIC_BUILD_TIMESTAMP_SHORT@"
#define KRYSTALLIC_BUILD_NUMBER          "b@KRYSTALLIC_BUILD_NUMBER@"
#define KRYSTALLIC_CODENAME              "@KRYSTALLIC_CODENAME@"
#define KRYSTALLIC_PLATFORM              "@KRYSTALLIC_PLATFORM@"
#define KRYSTALLIC_COMPILER              "@KRYSTALLIC_COMPILER@"

#ifndef KRYSTALLIC_BUILD_CONFIG
#define KRYSTALLIC_BUILD_CONFIG          "Unknown"
#endif

#ifndef KRYSTALLIC_BUILD_CONFIG_SHORT
#define KRYSTALLIC_BUILD_CONFIG_SHORT    "unk"
#endif

#define KRYSTALLIC_STAGE                 KRYSTALLIC_STAGE_MAJOR "." KRYSTALLIC_STAGE_MINOR
#define KRYSTALLIC_VERSION               KRYSTALLIC_VERSION_MAJ "." KRYSTALLIC_VERSION_MIN "." KRYSTALLIC_VERSION_REV

#define KRYSTALLIC_BUILD_STR             "v" KRYSTALLIC_STAGE "." KRYSTALLIC_VERSION "_" KRYSTALLIC_BUILD_NUMBER
#define KRYSTALLIC_BUILD_STR_EXT         KRYSTALLIC_STAGE_NAME " Build: " KRYSTALLIC_BUILD_STR " " KRYSTALLIC_BUILD_CONFIG " " KRYSTALLIC_PLATFORM " " KRYSTALLIC_BUILD_TIMESTAMP
#define KRYSTALLIC_BUILD_STR_FULL        KRYSTALLIC_BUILD_STR_EXT " Codename: \"" KRYSTALLIC_CODENAME "\" Compiler: " KRYSTALLIC_COMPILER
#define KRYSTALLIC_BUILD_ID              KRYSTALLIC_STAGE_NAME_SHORT " " KRYSTALLIC_BUILD_STR "." KRYSTALLIC_BUILD_TIMESTAMP_SHORT " (" KRYSTALLIC_BUILD_CONFIG_SHORT ")"

