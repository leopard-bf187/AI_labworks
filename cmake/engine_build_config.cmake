include_guard(GLOBAL)

set(KRYSTALLIC_BUILD_CONFIGURATIONS Debug Checked Release)

option(KRYSTALLIC_GENERATE_PDB_CHECKED "Generate PDB debug information for Checked builds on Windows" ON)
option(KRYSTALLIC_GENERATE_PDB_RELEASE "Generate PDB debug information for Release builds on Windows" OFF)

if(CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_CONFIGURATION_TYPES "Debug;Checked;Release" CACHE STRING "Krystallic build configurations" FORCE)
else()
    if(NOT CMAKE_BUILD_TYPE)
        set(CMAKE_BUILD_TYPE "Debug" CACHE STRING "Krystallic build configuration" FORCE)
    else()
        set(CMAKE_BUILD_TYPE "${CMAKE_BUILD_TYPE}" CACHE STRING "Krystallic build configuration" FORCE)
    endif()
    set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS ${KRYSTALLIC_BUILD_CONFIGURATIONS})
    if(NOT CMAKE_BUILD_TYPE IN_LIST KRYSTALLIC_BUILD_CONFIGURATIONS)
        message(FATAL_ERROR "Unsupported CMAKE_BUILD_TYPE='${CMAKE_BUILD_TYPE}'. Valid values: Debug, Checked, Release")
    endif()
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Android")
    set(_KRYSTALLIC_CHECKED_BASE_CONFIG "DEBUG")
else()
    set(_KRYSTALLIC_CHECKED_BASE_CONFIG "RELEASE")
endif()

foreach(_KRYSTALLIC_FLAG_VAR CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_STATIC_LINKER_FLAGS)
    if(DEFINED ${_KRYSTALLIC_FLAG_VAR}_${_KRYSTALLIC_CHECKED_BASE_CONFIG})
        set(${_KRYSTALLIC_FLAG_VAR}_CHECKED "${${_KRYSTALLIC_FLAG_VAR}_${_KRYSTALLIC_CHECKED_BASE_CONFIG}}" CACHE STRING "Flags used by the Checked configuration" FORCE)
    endif()
endforeach()

if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND (MSVC OR (CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")))
    function(_KrystallicSetPdbForConfig config enabled)
        string(TOUPPER "${config}" configUpper)

        foreach(flagVar CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
            set(currentFlags "${${flagVar}_${configUpper}}")
            string(REGEX REPLACE "(^|[ 	])/(Zi|ZI|Z7)([ 	]|$)" " " currentFlags "${currentFlags}")
            if(enabled)
                string(APPEND currentFlags " /Zi")
            endif()
            string(STRIP "${currentFlags}" currentFlags)
            set(${flagVar}_${configUpper} "${currentFlags}" CACHE STRING "Compiler flags used by the ${config} configuration" FORCE)
        endforeach()

        foreach(flagVar CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS)
            set(currentFlags "${${flagVar}_${configUpper}}")
            string(REGEX REPLACE "(^|[ 	])/DEBUG(:[A-Za-z]+)?([ 	]|$)" " " currentFlags "${currentFlags}")
            if(enabled)
                string(APPEND currentFlags " /DEBUG")
            endif()
            string(STRIP "${currentFlags}" currentFlags)
            set(${flagVar}_${configUpper} "${currentFlags}" CACHE STRING "Linker flags used by the ${config} configuration" FORCE)
        endforeach()
    endfunction()

    _KrystallicSetPdbForConfig(Checked ${KRYSTALLIC_GENERATE_PDB_CHECKED})
    _KrystallicSetPdbForConfig(Release ${KRYSTALLIC_GENERATE_PDB_RELEASE})
endif()

set(KRYSTALLIC_CONFIG_SUFFIX_GENEX "$<$<CONFIG:Debug>:d>$<$<CONFIG:Checked>:c>")

if(CMAKE_SYSTEM_NAME STREQUAL "Android")
    set(KRYSTALLIC_IMPORT_CONFIG_SUFFIX_GENEX "$<$<OR:$<CONFIG:Debug>,$<CONFIG:Checked>>:d>")
else()
    set(KRYSTALLIC_IMPORT_CONFIG_SUFFIX_GENEX "$<$<CONFIG:Debug>:d>")
endif()

function(KrystallicGetConfigSuffix config outSuffix)
    if(config STREQUAL "Debug")
        set(${outSuffix} "d" PARENT_SCOPE)
    elseif(config STREQUAL "Checked")
        set(${outSuffix} "c" PARENT_SCOPE)
    elseif(config STREQUAL "Release")
        set(${outSuffix} "" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Unsupported Krystallic build configuration '${config}'")
    endif()
endfunction()

message(STATUS "KRYSTALLIC_BUILD_CONFIGURATIONS=${KRYSTALLIC_BUILD_CONFIGURATIONS}")
message(STATUS "KRYSTALLIC_CHECKED_BASE_CONFIG=${_KRYSTALLIC_CHECKED_BASE_CONFIG}")
message(STATUS "KRYSTALLIC_GENERATE_PDB_CHECKED=${KRYSTALLIC_GENERATE_PDB_CHECKED}")
message(STATUS "KRYSTALLIC_GENERATE_PDB_RELEASE=${KRYSTALLIC_GENERATE_PDB_RELEASE}")

unset(_KRYSTALLIC_CHECKED_BASE_CONFIG)
unset(_KRYSTALLIC_FLAG_VAR)
