plugins {
    id 'com.android.application'
}

android {
    namespace '@ANDROID_APK_APPLICATION_ID@'
    compileSdk @ANDROID_APK_COMPILE_SDK@

    defaultConfig {
        applicationId '@ANDROID_APK_APPLICATION_ID@'
        minSdk @ANDROID_APK_MIN_SDK@
        targetSdk @ANDROID_APK_TARGET_SDK@
        versionCode @ANDROID_APK_VERSION_CODE@
        versionName '@ANDROID_APK_VERSION_NAME@'
    }

    sourceSets {
        main {
            jniLibs.srcDirs = ['@ANDROID_APK_JNI_LIBS_DIR@']
        }
    }

    buildTypes {
        debug {
            debuggable true
            minifyEnabled false
        }

        checked {
            initWith debug
            matchingFallbacks = ['debug']
            signingConfig signingConfigs.debug
        }

        release {
            minifyEnabled false
        }
    }
}
