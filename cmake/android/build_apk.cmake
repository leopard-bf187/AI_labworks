cmake_minimum_required(VERSION 3.10)

if(NOT DEFINED KRYSTALLIC_ANDROID_APK_PROJECT_NAME OR KRYSTALLIC_ANDROID_APK_PROJECT_NAME STREQUAL "")
    message(FATAL_ERROR "KRYSTALLIC_ANDROID_APK_PROJECT_NAME is not set")
endif()

if(NOT DEFINED KRYSTALLIC_ANDROID_APK_CONFIGURATION OR KRYSTALLIC_ANDROID_APK_CONFIGURATION STREQUAL "")
    message(FATAL_ERROR "KRYSTALLIC_ANDROID_APK_CONFIGURATION is not set")
endif()

if(NOT KRYSTALLIC_ANDROID_APK_CONFIGURATION STREQUAL "Release" AND NOT KRYSTALLIC_ANDROID_APK_CONFIGURATION STREQUAL "Checked" AND NOT KRYSTALLIC_ANDROID_APK_CONFIGURATION STREQUAL "Debug")
    message(FATAL_ERROR "Unsupported APK configuration '${KRYSTALLIC_ANDROID_APK_CONFIGURATION}'")
endif()

if(NOT DEFINED KRYSTALLIC_ANDROID_APK_PRESETS OR KRYSTALLIC_ANDROID_APK_PRESETS STREQUAL "")
    message(FATAL_ERROR "KRYSTALLIC_ANDROID_APK_PRESETS is not set")
endif()

get_filename_component(KRYSTALLIC_ANDROID_APK_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(KRYSTALLIC_ANDROID_APK_PROJECT_DIR "${KRYSTALLIC_ANDROID_APK_SOURCE_DIR}/__projects/android_apk/${KRYSTALLIC_ANDROID_APK_PROJECT_NAME}")
set(KRYSTALLIC_ANDROID_APK_CONFIG_FILE "${KRYSTALLIC_ANDROID_APK_PROJECT_DIR}/krystallic_apk_config.cmake")
set(KRYSTALLIC_ANDROID_APK_BUILD_DATA_DIR "${KRYSTALLIC_ANDROID_APK_SOURCE_DIR}/__build/AndroidAPK/${KRYSTALLIC_ANDROID_APK_PROJECT_NAME}")
set(KRYSTALLIC_ANDROID_APK_JNI_LIBS_DIR "${KRYSTALLIC_ANDROID_APK_BUILD_DATA_DIR}/jniLibs")

if(NOT EXISTS "${KRYSTALLIC_ANDROID_APK_CONFIG_FILE}")
    message(FATAL_ERROR "APK project '${KRYSTALLIC_ANDROID_APK_PROJECT_NAME}' is not configured. Missing '${KRYSTALLIC_ANDROID_APK_CONFIG_FILE}'")
endif()

include("${KRYSTALLIC_ANDROID_APK_CONFIG_FILE}")

if(NOT DEFINED KRYSTALLIC_ANDROID_APK_RUNTIME_ENTRIES OR KRYSTALLIC_ANDROID_APK_RUNTIME_ENTRIES STREQUAL "")
    message(FATAL_ERROR "APK project '${KRYSTALLIC_ANDROID_APK_PROJECT_NAME}' does not contain runtime dependency information. Reconfigure the Android CMake projects.")
endif()

if(NOT DEFINED KRYSTALLIC_ANDROID_APK_OUTPUT_NAME OR KRYSTALLIC_ANDROID_APK_OUTPUT_NAME STREQUAL "")
    message(FATAL_ERROR "APK project '${KRYSTALLIC_ANDROID_APK_PROJECT_NAME}' does not contain an output name. Reconfigure the Android CMake projects.")
endif()

if(NOT DEFINED KRYSTALLIC_ANDROID_APK_APPLICATION_VERSION OR KRYSTALLIC_ANDROID_APK_APPLICATION_VERSION STREQUAL "")
    message(FATAL_ERROR "APK project '${KRYSTALLIC_ANDROID_APK_PROJECT_NAME}' does not contain an application version. Reconfigure the Android CMake projects.")
endif()

function(_KrystallicGetAndroidPresetInfo preset outPlatform outAbi outTriple)
    if(preset STREQUAL "android_arm7")
        set(platform "AndroidArm7")
        set(abi "armeabi-v7a")
        set(triple "arm-linux-androideabi")
    elseif(preset STREQUAL "android_arm64")
        set(platform "AndroidArm64")
        set(abi "arm64-v8a")
        set(triple "aarch64-linux-android")
    elseif(preset STREQUAL "android_x86")
        set(platform "AndroidX86")
        set(abi "x86")
        set(triple "i686-linux-android")
    elseif(preset STREQUAL "android_x64")
        set(platform "AndroidX64")
        set(abi "x86_64")
        set(triple "x86_64-linux-android")
    elseif(preset STREQUAL "android_arm7c")
        set(platform "AndroidArm7c")
        set(abi "armeabi-v7a")
        set(triple "arm-linux-androideabi")
    elseif(preset STREQUAL "android_arm64c")
        set(platform "AndroidArm64c")
        set(abi "arm64-v8a")
        set(triple "aarch64-linux-android")
    elseif(preset STREQUAL "android_x86c")
        set(platform "AndroidX86c")
        set(abi "x86")
        set(triple "i686-linux-android")
    elseif(preset STREQUAL "android_x64c")
        set(platform "AndroidX64c")
        set(abi "x86_64")
        set(triple "x86_64-linux-android")
    elseif(preset STREQUAL "android_arm7d")
        set(platform "AndroidArm7d")
        set(abi "armeabi-v7a")
        set(triple "arm-linux-androideabi")
    elseif(preset STREQUAL "android_arm64d")
        set(platform "AndroidArm64d")
        set(abi "arm64-v8a")
        set(triple "aarch64-linux-android")
    elseif(preset STREQUAL "android_x86d")
        set(platform "AndroidX86d")
        set(abi "x86")
        set(triple "i686-linux-android")
    elseif(preset STREQUAL "android_x64d")
        set(platform "AndroidX64d")
        set(abi "x86_64")
        set(triple "x86_64-linux-android")
    else()
        message(FATAL_ERROR "Unknown Android preset '${preset}'")
    endif()

    set(${outPlatform} "${platform}" PARENT_SCOPE)
    set(${outAbi} "${abi}" PARENT_SCOPE)
    set(${outTriple} "${triple}" PARENT_SCOPE)
endfunction()

function(_KrystallicGetAndroidNDKRoot preset outNDKRoot)
    set(cacheFile "${KRYSTALLIC_ANDROID_APK_SOURCE_DIR}/__projects/${preset}/CMakeCache.txt")
    set(ndkRoot "")

    if(EXISTS "${cacheFile}")
        file(STRINGS "${cacheFile}" ndkCacheLines REGEX "^(ANDROID_NDK_ROOT|CMAKE_ANDROID_NDK|ANDROID_NDK):")
        foreach(cacheLine ${ndkCacheLines})
            if(cacheLine MATCHES "^[^=]+=(.*)$")
                set(ndkRoot "${CMAKE_MATCH_1}")
                break()
            endif()
        endforeach()
    endif()

    if(NOT ndkRoot AND DEFINED ENV{ANDROID_NDK_ROOT})
        set(ndkRoot "$ENV{ANDROID_NDK_ROOT}")
    endif()

    if(NOT ndkRoot AND DEFINED ENV{ANDROID_NDK_HOME})
        set(ndkRoot "$ENV{ANDROID_NDK_HOME}")
    endif()

    set(${outNDKRoot} "${ndkRoot}" PARENT_SCOPE)
endfunction()

function(_KrystallicCopyAndroidCxxShared preset abi triple destination)
    _KrystallicGetAndroidNDKRoot("${preset}" ndkRoot)

    if(NOT ndkRoot)
        message(FATAL_ERROR "Cannot determine Android NDK root for preset '${preset}'")
    endif()

    file(GLOB cxxSharedCandidates "${ndkRoot}/toolchains/llvm/prebuilt/*/sysroot/usr/lib/${triple}/libc++_shared.so")
    list(LENGTH cxxSharedCandidates cxxSharedCount)

    if(cxxSharedCount EQUAL 0)
        message(FATAL_ERROR "libc++_shared.so for ABI '${abi}' was not found in '${ndkRoot}'")
    endif()

    list(GET cxxSharedCandidates 0 cxxSharedLibrary)
    file(COPY "${cxxSharedLibrary}" DESTINATION "${destination}")
endfunction()

function(_KrystallicFindAndroidRuntimeLibrary runtimeTarget runtimeOutputName platform outLibrary)
    set(runtimeLibraryName "lib${runtimeOutputName}.so")
    file(GLOB runtimeLibraries "${KRYSTALLIC_ANDROID_APK_SOURCE_DIR}/__build/Clang/${platform}/${runtimeLibraryName}")
    list(LENGTH runtimeLibraries runtimeLibraryCount)

    if(runtimeLibraryCount EQUAL 0)
        set(${outLibrary} "" PARENT_SCOPE)
        return()
    endif()

    list(SORT runtimeLibraries)
    list(GET runtimeLibraries 0 runtimeLibrary)
    set(${outLibrary} "${runtimeLibrary}" PARENT_SCOPE)
endfunction()

function(_KrystallicStageAndroidPreset preset outWasStaged outAbi)
    _KrystallicGetAndroidPresetInfo("${preset}" platform abi triple)
    set(projectDir "${KRYSTALLIC_ANDROID_APK_SOURCE_DIR}/__projects/${preset}")

    if(NOT EXISTS "${projectDir}/CMakeCache.txt")
        message(STATUS "APK: skipping ${preset} (${abi}): project is not configured")
        set(${outWasStaged} FALSE PARENT_SCOPE)
        set(${outAbi} "${abi}" PARENT_SCOPE)
        return()
    endif()

    set(runtimeLibraries)
    set(runtimeLibraryNames)

    foreach(runtimeEntry ${KRYSTALLIC_ANDROID_APK_RUNTIME_ENTRIES})
        if(NOT runtimeEntry MATCHES "^([^|]+)\\|(.+)$")
            message(FATAL_ERROR "Invalid APK runtime entry '${runtimeEntry}'")
        endif()

        set(runtimeTarget "${CMAKE_MATCH_1}")
        set(runtimeOutputName "${CMAKE_MATCH_2}")
        _KrystallicFindAndroidRuntimeLibrary("${runtimeTarget}" "${runtimeOutputName}" "${platform}" runtimeLibrary)

        if(NOT runtimeLibrary)
            message(STATUS "APK: skipping ${preset} (${abi}): lib${runtimeOutputName}.so is not built")
            set(${outWasStaged} FALSE PARENT_SCOPE)
            set(${outAbi} "${abi}" PARENT_SCOPE)
            return()
        endif()

        list(APPEND runtimeLibraries "${runtimeLibrary}")
        list(APPEND runtimeLibraryNames "lib${runtimeOutputName}.so")
    endforeach()

    set(destination "${KRYSTALLIC_ANDROID_APK_JNI_LIBS_DIR}/${abi}")
    file(MAKE_DIRECTORY "${destination}")

    foreach(runtimeLibrary ${runtimeLibraries})
        file(COPY "${runtimeLibrary}" DESTINATION "${destination}")
    endforeach()

    _KrystallicCopyAndroidCxxShared("${preset}" "${abi}" "${triple}" "${destination}")
    string(REPLACE ";" ", " runtimeLibraryText "${runtimeLibraryNames}")
    message(STATUS "APK: added ${preset} -> ${abi}: ${runtimeLibraryText}, libc++_shared.so")
    set(${outWasStaged} TRUE PARENT_SCOPE)
    set(${outAbi} "${abi}" PARENT_SCOPE)
endfunction()

function(BuildAndroidAPK)
    file(REMOVE_RECURSE "${KRYSTALLIC_ANDROID_APK_JNI_LIBS_DIR}")
    file(MAKE_DIRECTORY "${KRYSTALLIC_ANDROID_APK_JNI_LIBS_DIR}")

    set(includedAbis)
    foreach(preset ${KRYSTALLIC_ANDROID_APK_PRESETS})
        _KrystallicStageAndroidPreset("${preset}" wasStaged stagedAbi)
        if(wasStaged)
            list(APPEND includedAbis "${stagedAbi}")
        endif()
    endforeach()

    list(LENGTH includedAbis includedAbiCount)
    if(includedAbiCount EQUAL 0)
        message(FATAL_ERROR "No built Android APK targets were found for configuration '${KRYSTALLIC_ANDROID_APK_CONFIGURATION}'")
    endif()

    find_program(KRYSTALLIC_ANDROID_APK_GRADLE_EXECUTABLE NAMES gradle.bat gradle)
    if(NOT KRYSTALLIC_ANDROID_APK_GRADLE_EXECUTABLE)
        message(FATAL_ERROR "Gradle executable was not found in PATH")
    endif()

    set(gradleTask "assemble${KRYSTALLIC_ANDROID_APK_CONFIGURATION}")
    execute_process(COMMAND "${KRYSTALLIC_ANDROID_APK_GRADLE_EXECUTABLE}" --project-dir "${KRYSTALLIC_ANDROID_APK_PROJECT_DIR}" "${gradleTask}" RESULT_VARIABLE gradleResult)
    if(NOT gradleResult EQUAL 0)
        message(FATAL_ERROR "Gradle task '${gradleTask}' failed with exit code ${gradleResult}")
    endif()

    string(TOLOWER "${KRYSTALLIC_ANDROID_APK_CONFIGURATION}" configurationLower)
    set(gradleApkDir "${KRYSTALLIC_ANDROID_APK_BUILD_DATA_DIR}/gradle/app/outputs/apk/${configurationLower}")
    set(gradleApk "${gradleApkDir}/app-${configurationLower}.apk")
    if(NOT EXISTS "${gradleApk}" AND KRYSTALLIC_ANDROID_APK_CONFIGURATION STREQUAL "Release")
        set(gradleApk "${gradleApkDir}/app-release-unsigned.apk")
    endif()
    if(NOT EXISTS "${gradleApk}")
        file(GLOB gradleApks "${gradleApkDir}/*.apk")
        list(LENGTH gradleApks gradleApkCount)
        if(gradleApkCount EQUAL 0)
            message(FATAL_ERROR "Gradle completed successfully, but no APK was found in '${gradleApkDir}'")
        endif()
        list(SORT gradleApks)
        list(GET gradleApks 0 gradleApk)
    endif()

    if(KRYSTALLIC_ANDROID_APK_CONFIGURATION STREQUAL "Debug")
        set(configurationSuffix "dbg")
    elseif(KRYSTALLIC_ANDROID_APK_CONFIGURATION STREQUAL "Checked")
        set(configurationSuffix "chk")
    else()
        set(configurationSuffix "rel")
    endif()

    string(REGEX REPLACE "[^A-Za-z0-9._-]" "_" outputNameSafe "${KRYSTALLIC_ANDROID_APK_OUTPUT_NAME}")
    string(REGEX REPLACE "[^A-Za-z0-9._-]" "_" applicationVersionSafe "${KRYSTALLIC_ANDROID_APK_APPLICATION_VERSION}")
    set(finalOutputDir "${KRYSTALLIC_ANDROID_APK_SOURCE_DIR}/__install/${KRYSTALLIC_ANDROID_APK_OUTPUT_VERSION}")
    set(finalOutput "${finalOutputDir}/${outputNameSafe}_v${applicationVersionSafe}_${configurationSuffix}.apk")
    file(MAKE_DIRECTORY "${finalOutputDir}")
    file(REMOVE "${finalOutput}")
    file(COPY "${gradleApk}" DESTINATION "${finalOutputDir}")
    get_filename_component(gradleApkName "${gradleApk}" NAME)
    file(RENAME "${finalOutputDir}/${gradleApkName}" "${finalOutput}")

    string(REPLACE ";" ", " includedAbiText "${includedAbis}")
    message(STATUS "APK: ${KRYSTALLIC_ANDROID_APK_CONFIGURATION} ABIs: ${includedAbiText}")
    message(STATUS "APK: output -> ${finalOutput}")
endfunction()

BuildAndroidAPK()
