set(KRYSTALLIC_STAGE "InDev" CACHE STRING "Krystallic Engine development stage")
set_property(CACHE KRYSTALLIC_STAGE PROPERTY STRINGS InDev Alpha Beta RC RTM)

set(KRYSTALLIC_VERSION_X "0")
set(KRYSTALLIC_VERSION_Y "3")
set(KRYSTALLIC_VERSION_Z "2")
set(KRYSTALLIC_CODENAME "Neural Emerald")

set(KRYSTALLIC_BUILD_EPOCH "2025-12-05")

set(_KRYSTALLIC_VALID_STAGES InDev Alpha Beta RC RTM)
list(FIND _KRYSTALLIC_VALID_STAGES "${KRYSTALLIC_STAGE}" _KRYSTALLIC_STAGE_INDEX)
if(_KRYSTALLIC_STAGE_INDEX EQUAL -1)
    message(FATAL_ERROR "Invalid KRYSTALLIC_STAGE='${KRYSTALLIC_STAGE}'. Valid values: InDev, Alpha, Beta, RC, RTM")
endif()

string(TOLOWER "${KRYSTALLIC_STAGE}" KRYSTALLIC_STAGE_SHORT)

set(KRYSTALLIC_COMPILER "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")

find_program(LUA_EXE NAMES lua.exe lua lua55.exe lua55 lua5.5 lua54.exe lua54 lua5.4 lua53.exe lua53 lua5.3 lua52.exe lua52 lua5.2 lua51.exe lua51 lua5.1 luajit.exe luajit PATHS "${KRYSTALLIC_UTILS_DIR}" NO_DEFAULT_PATH)
if(NOT LUA_EXE)
    find_program(LUA_EXE NAMES lua.exe lua lua55.exe lua55 lua5.5 lua54.exe lua54 lua5.4 lua53.exe lua53 lua5.3 lua52.exe lua52 lua5.2 lua51.exe lua51 lua5.1 luajit.exe luajit)
endif()

message(STATUS "KRYSTALLIC_STAGE=${KRYSTALLIC_STAGE}")
message(STATUS "KRYSTALLIC_UTILS_DIR=${KRYSTALLIC_UTILS_DIR}")
message(STATUS "LUA_EXE=${LUA_EXE}")

if(LUA_EXE)
    execute_process(COMMAND "${LUA_EXE}" "${CMAKE_SOURCE_DIR}/cmake/krystallic_engine_build_number.lua" "${KRYSTALLIC_BUILD_EPOCH}" OUTPUT_VARIABLE KRYSTALLIC_BUILD_METADATA ERROR_VARIABLE KRYSTALLIC_BUILD_ERROR RESULT_VARIABLE KRYSTALLIC_BUILD_RESULT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE)

    if(NOT KRYSTALLIC_BUILD_RESULT EQUAL 0)
        message(FATAL_ERROR "Krystallic build metadata generation failed: ${KRYSTALLIC_BUILD_ERROR}")
    endif()

    string(REPLACE "\r\n" "\n" KRYSTALLIC_BUILD_METADATA "${KRYSTALLIC_BUILD_METADATA}")
    string(REPLACE "\r" "\n" KRYSTALLIC_BUILD_METADATA "${KRYSTALLIC_BUILD_METADATA}")
    string(REPLACE "\n" ";" KRYSTALLIC_BUILD_METADATA_LIST "${KRYSTALLIC_BUILD_METADATA}")
    list(LENGTH KRYSTALLIC_BUILD_METADATA_LIST KRYSTALLIC_BUILD_METADATA_COUNT)

    if(NOT KRYSTALLIC_BUILD_METADATA_COUNT EQUAL 3)
        message(FATAL_ERROR "Invalid Krystallic build metadata output: '${KRYSTALLIC_BUILD_METADATA}'")
    endif()

    list(GET KRYSTALLIC_BUILD_METADATA_LIST 0 KRYSTALLIC_BUILD_NUMBER)
    list(GET KRYSTALLIC_BUILD_METADATA_LIST 1 KRYSTALLIC_BUILD_TIMESTAMP)
    list(GET KRYSTALLIC_BUILD_METADATA_LIST 2 KRYSTALLIC_BUILD_TIMESTAMP_SHORT)
else()
    set(KRYSTALLIC_BUILD_RESULT "")
    set(KRYSTALLIC_BUILD_ERROR "")
    set(KRYSTALLIC_BUILD_NUMBER "0")

    set(KRYSTALLIC_BUILD_TIMESTAMP_FILE "${CMAKE_SOURCE_DIR}/cmake/krystallic_engine_build_timestamp.txt")
    if(EXISTS "${KRYSTALLIC_BUILD_TIMESTAMP_FILE}")
        file(STRINGS "${KRYSTALLIC_BUILD_TIMESTAMP_FILE}" KRYSTALLIC_BUILD_TIMESTAMP LIMIT_COUNT 1)
    else()
        string(TIMESTAMP KRYSTALLIC_BUILD_TIMESTAMP "%Y-%m-%d %H:%M:%S")
        file(WRITE "${KRYSTALLIC_BUILD_TIMESTAMP_FILE}" "${KRYSTALLIC_BUILD_TIMESTAMP}\n")
    endif()

    if(NOT KRYSTALLIC_BUILD_TIMESTAMP MATCHES "^([0-9][0-9])[0-9][0-9]-([0-9][0-9])-([0-9][0-9]) ([0-9][0-9]):([0-9][0-9]):([0-9][0-9])$")
        message(FATAL_ERROR "Invalid KRYSTALLIC_BUILD_TIMESTAMP='${KRYSTALLIC_BUILD_TIMESTAMP}'. Expected YYYY-MM-DD HH:MM:SS.")
    endif()
    string(REGEX REPLACE "^([0-9][0-9])([0-9][0-9])-([0-9][0-9])-([0-9][0-9]) ([0-9][0-9]):([0-9][0-9]):([0-9][0-9])$" "\\2\\3\\4-\\5\\6" KRYSTALLIC_BUILD_TIMESTAMP_SHORT "${KRYSTALLIC_BUILD_TIMESTAMP}")
endif()

if(NOT KRYSTALLIC_BUILD_NUMBER MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid KRYSTALLIC_BUILD_NUMBER='${KRYSTALLIC_BUILD_NUMBER}'. Build number must be a non-negative integer.")
endif()
if(NOT KRYSTALLIC_BUILD_TIMESTAMP MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]$")
    message(FATAL_ERROR "Invalid KRYSTALLIC_BUILD_TIMESTAMP='${KRYSTALLIC_BUILD_TIMESTAMP}'. Expected YYYY-MM-DD HH:MM:SS.")
endif()
if(NOT KRYSTALLIC_BUILD_TIMESTAMP_SHORT MATCHES "^[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]$")
    message(FATAL_ERROR "Invalid KRYSTALLIC_BUILD_TIMESTAMP_SHORT='${KRYSTALLIC_BUILD_TIMESTAMP_SHORT}'. Expected YYMMDD-HHMM.")
endif()

message(STATUS "KRYSTALLIC_BUILD_TIMESTAMP=${KRYSTALLIC_BUILD_TIMESTAMP}")
message(STATUS "KRYSTALLIC_BUILD_TIMESTAMP_SHORT=${KRYSTALLIC_BUILD_TIMESTAMP_SHORT}")

set(KRYSTALLIC_PRODUCT_VERSION "${KRYSTALLIC_VERSION_X}.${KRYSTALLIC_VERSION_Y}.${KRYSTALLIC_VERSION_Z}")
set(KRYSTALLIC_VERSION "${KRYSTALLIC_PRODUCT_VERSION}.${KRYSTALLIC_BUILD_NUMBER}")
set(KRYSTALLIC_BUILD_OUTPUT_DIRECTORY "${KRYSTALLIC_STAGE_SHORT}_${KRYSTALLIC_VERSION}.${KRYSTALLIC_BUILD_TIMESTAMP_SHORT}")

if(DEFINED KRYSTALLIC_PLATFORM AND NOT "${KRYSTALLIC_PLATFORM}" STREQUAL "")
    string(TOLOWER "${KRYSTALLIC_PLATFORM}" KRYSTALLIC_PLATFORM_SHORT)
else()
    set(KRYSTALLIC_PLATFORM_SHORT "unknown")
endif()

message(STATUS "KRYSTALLIC_PRODUCT_VERSION=${KRYSTALLIC_PRODUCT_VERSION}")
message(STATUS "KRYSTALLIC_VERSION=${KRYSTALLIC_VERSION}")
message(STATUS "KRYSTALLIC_BUILD_OUTPUT_DIRECTORY=${KRYSTALLIC_BUILD_OUTPUT_DIRECTORY}")
message(STATUS "KRYSTALLIC_BUILD_RESULT=${KRYSTALLIC_BUILD_RESULT}")
message(STATUS "KRYSTALLIC_BUILD_NUMBER=${KRYSTALLIC_BUILD_NUMBER}")
message(STATUS "KRYSTALLIC_BUILD_ERROR=${KRYSTALLIC_BUILD_ERROR}")

configure_file("${CMAKE_SOURCE_DIR}/cmake/__config.h.in" "${CMAKE_SOURCE_DIR}/public/__config.h" @ONLY)
