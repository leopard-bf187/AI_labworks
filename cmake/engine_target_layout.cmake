include("${CMAKE_SOURCE_DIR}/cmake/engine_build_config.cmake")

set(SRC_ROOT_DIR "${CMAKE_SOURCE_DIR}")
set(SRC_BUILD_DATA_DIR "${SRC_ROOT_DIR}/__build")

if(CMAKE_CONFIGURATION_TYPES)
    set(SRC_CONFIG_NAME "$<CONFIG>")
    set(SRC_CONFIG_SUFFIX "${KRYSTALLIC_CONFIG_SUFFIX_GENEX}")
else()
    set(SRC_CONFIG_NAME "${CMAKE_BUILD_TYPE}")
    KrystallicGetConfigSuffix("${CMAKE_BUILD_TYPE}" SRC_CONFIG_SUFFIX)
endif()

set(SRC_PLATFORM "${KRYSTALLIC_PLATFORM}${SRC_CONFIG_SUFFIX}")

set(SRC_ENG_VER_V1 "${KRYSTALLIC_STAGE_SHORT}_${KRYSTALLIC_VERSION}")
set(SRC_ENG_VER_V2 "${KRYSTALLIC_BUILD_OUTPUT_DIRECTORY}")

if(KRYSTALLIC_USE_TIMESTAMP_IN_INSTALL_DIR)
    set(SRC_ENG_VER "${SRC_ENG_VER_V2}")
else()
    set(SRC_ENG_VER "${SRC_ENG_VER_V1}")
endif()

set(SRC_FINAL_ENGINE_DIR "${SRC_ROOT_DIR}/__install/${SRC_ENG_VER}/${SRC_PLATFORM}")

message(STATUS "SRC_PLATFORM=${SRC_PLATFORM}")
message(STATUS "SRC_ENG_VER=${SRC_ENG_VER}")
message(STATUS "SRC_FINAL_ENGINE_DIR=${SRC_FINAL_ENGINE_DIR}")

option(KRYSTALLIC_ENGINE_INSTALL_LAYOUT "Install targets into Krystallic engine runtime layout" ON)

function(SetEngineTargetLayout target)
    set(TARGET_TEMP_DIR "${SRC_BUILD_DATA_DIR}/${CMAKE_CXX_COMPILER_ID}/${SRC_PLATFORM}")
    set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${TARGET_TEMP_DIR}" LIBRARY_OUTPUT_DIRECTORY "${TARGET_TEMP_DIR}" ARCHIVE_OUTPUT_DIRECTORY "${TARGET_TEMP_DIR}" PDB_OUTPUT_DIRECTORY "${TARGET_TEMP_DIR}" COMPILE_PDB_OUTPUT_DIRECTORY "${TARGET_TEMP_DIR}")

    if(MSVC)
        set_target_properties(${target} PROPERTIES VS_GLOBAL_IntDir "${SRC_BUILD_DATA_DIR}/${CMAKE_CXX_COMPILER_ID}/${SRC_PLATFORM}/objs/${target}/")
    endif()

    if(KRYSTALLIC_ENGINE_INSTALL_LAYOUT)
        install(TARGETS ${target} RUNTIME DESTINATION "${SRC_FINAL_ENGINE_DIR}" LIBRARY DESTINATION "${SRC_FINAL_ENGINE_DIR}" ARCHIVE DESTINATION "${SRC_FINAL_ENGINE_DIR}")
    else()
        install(TARGETS ${target} RUNTIME DESTINATION bin LIBRARY DESTINATION lib ARCHIVE DESTINATION lib)
    endif()
endfunction()
