# Link the executable BenchmarkTests.exe

build BenchmarkTests.exe: CXX_EXECUTABLE_LINKER__BenchmarkTests_Release CMakeFiles/BenchmarkTests.dir/tests/BenchmarkTests.cpp.obj | Benchmark.lib Minimax.lib AlphaBeta.lib GameTree.lib || AlphaBeta.lib Benchmark.lib GameTree.lib Minimax.lib
  CONFIG = Release
  FLAGS = -O3 -DNDEBUG -D_DLL -D_MT -Xclang --dependent-lib=msvcrt
  LINK_FLAGS = -Xlinker /subsystem:console -fuse-ld=lld-link
  LINK_LIBRARIES = Benchmark.lib  Minimax.lib  AlphaBeta.lib  GameTree.lib  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -loldnames
  OBJECT_DIR = CMakeFiles\BenchmarkTests.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = CMakeFiles\BenchmarkTests.dir\
  TARGET_FILE = BenchmarkTests.exe
  TARGET_IMPLIB = BenchmarkTests.lib
  TARGET_PDB = BenchmarkTests.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\BenchmarkTests.dir


